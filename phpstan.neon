parameters:
    level: 8
    paths:
        - src
    # Files generated by the Symfony skeleton are never edited here — not to fix a style rule,
    # not to silence an analyser — so that a framework upgrade can replace them as is.
    excludePaths:
        - src/Kernel.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
